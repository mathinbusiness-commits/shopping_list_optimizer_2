# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# dev.db SÍ se versiona a propósito: la app solo lee de ella en runtime (nunca
# escribe), y Vercel necesita el archivo empaquetado en el deploy para funcionar
# (ver next.config.ts outputFileTracingIncludes y src/lib/db.ts). Los archivos de
# journal/wal/shm son estado transitorio de escritura local, esos sí se ignoran.
/dev.db-journal
/dev.db-wal
/dev.db-shm
