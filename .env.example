# Base de datos SQLite local (dev.db se crea con `npm run db:push`)
DATABASE_URL="file:./dev.db"

# Geocodificación de direcciones (OpenStreetMap Nominatim, gratuito).
# El User-Agent debe identificar la app según la política de uso de Nominatim.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="mi_app-course-project/1.0 (contacto: tu-email@ejemplo.com)"

# Distancias/tiempos de viaje (servidor demo público de OSRM, gratuito, bajo volumen).
OSRM_BASE_URL="https://router.project-osrm.org"

# Parámetros del optimizador
MAX_STOPS_DEFAULT=3
STOP_OVERHEAD_MIN=10
STALE_THRESHOLD_HOURS=168

# Rate limiting del scraper (ms entre requests al mismo dominio)
SCRAPE_RATE_LIMIT_MS=1500
